{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}", // Устанавливает рабочую директорию как корень проекта
            "env": {
                "PYTHONPATH": "${workspaceFolder}" // Добавляет корень в PYTHONPATH
            }
        }
    ]
}